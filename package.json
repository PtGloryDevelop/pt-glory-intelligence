{
  "name": "pt-glory-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/*.test.ts tests/collector/*.test.ts tests/db/*.test.ts",
    "test:db": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/db/*.test.ts",
    "check:imports": "node scripts/check-privileged-imports.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:imports && npm test && npm run build",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "verify:gate-a": "node --env-file-if-exists=.env.local scripts/verify-gate-a.mjs",
    "test:unit": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/*.test.ts tests/collector/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^16.3.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
