# Copy to deploy/owned-sync/.env and fill in. .env is never committed (.gitignore covers .env*).

# Where the Ads Management checkout is on this server (mounted read-only into the container).
ADS_MANAGEMENT_DIR=

# ส่องแอด (pt-glory-intelligence) database and file storage.
# DATABASE_URL: the Session pooler string (…pooler.supabase.com:5432), which works over IPv4.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The ส่องแอด admin the sync is recorded under (a user id), and the Ads Management admin email it
# reads as. Same values as on the machine that runs the sync today.
OWNED_SYNC_ACTOR_ID=
OWNED_MANAGEMENT_AUTHORIZED_EMAIL=

# Ads Management database: the same three values as its own server configuration on this machine.
ADS_SUPABASE_URL=
ADS_SUPABASE_SERVICE_ROLE_KEY=
ADS_TOKEN_ENCRYPTION_KEY=

# Optional. Bangkok times; default 09:00,13:00,18:00.
# OWNED_SYNC_TIMES=09:00,13:00,18:00
