# --- client-visible (safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- server only: never expose to the browser ---
# Used exclusively by lib/db/privileged.ts for the import transaction.
# This connection BYPASSES RLS, so every caller must pass requireRole() first.
# Use the Supabase transaction-mode pooler (port 6543) in hosted environments.
DATABASE_URL=

# --- verification only (tests/db) ---
# Needed by tests/db/auth-chain.test.ts to create and delete throwaway users.
# Never set these in a production environment.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
