# --- which environment this shell is ---
# Required by every destructive path (fixture truncation, Playwright global
# setup, `migrate down`, the synthetic seed script). Unset is a refusal, never a
# default: a forgotten variable must not read as consent to wipe a database.
#   dev | test   disposable, local only
#   pilot        the shared Supabase Cloud project — destructive paths always refuse
PT_GLORY_ENV=dev

# Second switch, set deliberately per shell. Both this and PT_GLORY_ENV must be
# right before anything truncates, AND the target must be a local database:
# no combination of variables can point a reset at Supabase Cloud.
ALLOW_DESTRUCTIVE_DB_RESET=1

# --- client-visible (safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- server only: never expose to the browser ---
# Used exclusively by lib/db/privileged.ts for the import transaction.
# This connection BYPASSES RLS, so every caller must pass requireRole() first.
# Use the Supabase transaction-mode pooler (port 6543) in hosted environments.
# Local development and every test run use the local Supabase stack
# (`supabase start`), which is the only database the destructive paths accept:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- verification only (tests/db) ---
# Needed by tests/db/auth-chain.test.ts to create and delete throwaway users.
# Never set these in a production environment.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Machine credential for the scheduled media archive drain. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the media_archive_token secret in Supabase Vault.
MEDIA_ARCHIVE_TOKEN=

# Local server-only owned-ad bridge; source database credentials stay in the
# source project's .env.local. Separate-host deployment requires an export API.
OWNED_MANAGEMENT_PROJECT_PATH=
OWNED_MANAGEMENT_AUTHORIZED_EMAIL=
# Optional server-only env file with the encryption key matching Management's
# stored connection token (for example, its production environment file).
OWNED_MANAGEMENT_TOKEN_ENV_PATH=
# Optional direct server-side Facebook token file. Defaults to Token Facebook.txt
# inside the source project when present. Never expose this through NEXT_PUBLIC.
OWNED_MANAGEMENT_ACCESS_TOKEN_FILE=
